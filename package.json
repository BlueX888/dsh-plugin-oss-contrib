{
  "name": "dsh-plugin-oss-contrib",
  "version": "0.1.0",
  "description": "Open source contribution pipeline for DeepSeek Harness - hunt, ship, track PRs across GitHub repositories",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test tests/**/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["dsh-plugin", "oss", "github", "contribution", "agent"],
  "author": "BlueX888",
  "license": "MIT",
  "type": "module",
  "dsh": {
    "bundle": true,
    "patchFile": "cordis.patch.yml"
  },
  "dependencies": {
    "cordis": "^4.0.0-rc.9",
    "schemastery": "^3.14.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.9"
  }
}
